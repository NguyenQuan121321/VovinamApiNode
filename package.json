{
  "name": "vovinam-api-node",
  "version": "0.1.0",
  "description": "Vovinam club management API: students, classes, belts, exams, billing, notifications",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"prisma/seed.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"prisma/seed.ts\"",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"prisma/seed.ts\" --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "start": "node --enable-source-maps dist/main.js",
    "start:dev": "nest start --watch",
    "test": "jest",
    "test:e2e": "jest --config test/jest-e2e.json --runInBand",
    "test:uat": "node --test test/uat/uat-runner.spec.mjs test/uat/generate-uat-md.spec.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "seed": "prisma db seed",
    "openapi:generate": "ts-node scripts/generate-openapi.ts",
    "contract:lint": "node scripts/lint-openapi.cjs"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "6.12.0",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^16.4.7",
    "helmet": "^8.0.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.0.10",
    "otplib": "12.0.1",
    "pino": "^9.6.0",
    "prisma": "6.12.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.2",
    "@usebruno/cli": "^4.2.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^30.5.2",
    "license-checker": "^25.0.1",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "@stoplight/spectral-core": "^1.24.0",
    "@stoplight/spectral-rulesets": "^1.23.0",
    "@stoplight/spectral-parsers": "^1.0.5",
    "js-yaml": "^4.3.2"
  },
  "overrides": {
    "multer": "^2.4.0",
    "@usebruno/cli": {
      "form-data": "^4.0.6",
      "js-yaml": "^4.3.2",
      "@faker-js/faker": "^10.5.0",
      "yaml": "^2.8.3",
      "csv-parse": "^7.0.2"
    },
    "@usebruno/converters": {
      "js-yaml": "^4.3.2"
    },
    "@usebruno/requests": {
      "@faker-js/faker": "^10.5.0"
    },
    "@usebruno/filestore": {
      "yaml": "^2.8.3"
    },
    "@usebruno/js": {
      "yaml": "^2.8.3"
    },
    "axios": "^1.20.0",
    "uuid": "^11.1.1",
    "@nestjs/swagger": {
      "js-yaml": "^4.3.2"
    }
  },
  "allowScripts": {
    "@scarf/scarf": false,
    "prisma@6.12.0": true,
    "@prisma/engines@6.12.0": true,
    "otplib@12.0.1": true,
    "@prisma/client@6.12.0": true
  }
}
