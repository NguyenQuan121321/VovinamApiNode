meta {
  name: instructor posts to own class
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/announcements
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{instructorToken}}
  content-type: application/json
}

body:json {
  {"title": "UAT instructor notice", "body": "Extra drill this week", "audience": "CLASS", "classId": "{{basicClassId}}"}
}

tests {
  test("status 201", function() { expect(res.status).to.equal(201); });
}
