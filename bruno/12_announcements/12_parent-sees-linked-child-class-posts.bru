meta {
  name: parent sees linked child class posts
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/api/v1/announcements
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{parentToken}}
}

tests {
  test("status 200", function() { expect(res.status).to.equal(200); });
  test("basic class visible to parent", function() { expect(res.body.data.items.some(function(a){ return a.id === bru.getEnvVar("classAnnouncementId"); })).to.equal(true); });
}
