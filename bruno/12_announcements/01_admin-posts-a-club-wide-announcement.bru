meta {
  name: admin posts a club-wide announcement
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/announcements
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{adminToken}}
  content-type: application/json
}

body:json {
  {"title": "UAT club notice", "body": "Open training next Sunday", "audience": "ALL"}
}

script:post-response {
  const data = res.body.data;
  bru.setEnvVar("clubAnnouncementId", data.id);
}

tests {
  test("status 201", function() { expect(res.status).to.equal(201); });
}
