meta {
  name: attendance report (instructor scoped)
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/api/v1/admin/reports/attendance?month={{curYear}}-{{curMonthPadded}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{instructorToken}}
}

tests {
  test("status 200", function() { expect(res.status).to.equal(200); });
}
