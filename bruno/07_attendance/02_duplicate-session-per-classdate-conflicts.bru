meta {
  name: duplicate session per class/date conflicts
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/attendance-sessions
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{instructorToken}}
  content-type: application/json
}

body:json {
  {"classId": "{{basicClassId}}", "sessionDate": "2026-09-26"}
}

tests {
  test("status 409", function() { expect(res.status).to.equal(409); });
}
