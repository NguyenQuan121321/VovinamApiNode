meta {
  name: student cannot read admin report
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/api/v1/admin/reports/attendance?month={{curYear}}-{{curMonthPadded}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{studentToken}}
}

tests {
  test("status 403", function() { expect(res.status).to.equal(403); });
}
