meta {
  name: duplicate leave for the same session conflicts
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/leave-requests
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{studentToken}}
  content-type: application/json
}

body:json {
  {"studentId": "{{studentId}}", "classId": "{{basicClassId}}", "sessionDate": "2026-09-26", "reason": "again"}
}

tests {
  test("status 409", function() { expect(res.status).to.equal(409); });
}
