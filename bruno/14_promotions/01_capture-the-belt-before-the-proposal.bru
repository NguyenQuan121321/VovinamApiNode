meta {
  name: capture the belt before the proposal
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/students/me
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{studentToken}}
}

script:post-response {
  const data = res.body.data;
  bru.setEnvVar("beltBeforeProposal", String(data.currentBeltRankId));
}

tests {
  test("status 200", function() { expect(res.status).to.equal(200); });
}
