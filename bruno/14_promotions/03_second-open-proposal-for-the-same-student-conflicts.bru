meta {
  name: second open proposal for the same student conflicts
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/promotion-proposals
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{instructorToken}}
  content-type: application/json
}

body:json {
  {"studentId": "{{studentId}}", "proposedRankId": "{{nextRankId}}"}
}

tests {
  test("status 409", function() { expect(res.status).to.equal(409); });
}
