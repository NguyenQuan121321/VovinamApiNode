meta {
  name: student cannot create evaluations
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/v1/evaluations
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{studentToken}}
  content-type: application/json
}

body:json {
  {"studentId": "{{studentId}}", "rating": 10}
}

tests {
  test("status 403", function() { expect(res.status).to.equal(403); });
}
