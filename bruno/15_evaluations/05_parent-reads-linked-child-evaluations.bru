meta {
  name: parent reads linked child evaluations
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/v1/evaluations?studentId={{minorCId}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{parentToken}}
}

tests {
  test("status 200", function() { expect(res.status).to.equal(200); });
  test("empty but allowed", function() { expect(res.body.data.items).to.be.an("array"); });
}
