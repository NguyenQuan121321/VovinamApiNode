meta {
  name: duplicate period evaluation conflicts
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/evaluations
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{instructorToken}}
  content-type: application/json
}

body:json {
  {"studentId": "{{studentId}}", "rating": 9, "periodMonth": 1, "periodYear": 2020}
}

tests {
  test("status 409", function() { expect(res.status).to.equal(409); });
}
