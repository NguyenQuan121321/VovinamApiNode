meta {
  name: unknown class id is a uniform 404 (not a 500)
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/evaluations
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{instructorToken}}
  content-type: application/json
}

body:json {
  {"studentId": "{{studentId}}", "classId": "00000000-0000-4000-8000-000000000000", "rating": 7}
}

tests {
  test("status 404", function() { expect(res.status).to.equal(404); });
}

docs {
  Regression: an unknown classId used to surface as a raw FK violation (500).
}
