meta {
  name: belt actually promoted
  type: http
  seq: 19
}

get {
  url: {{baseUrl}}/api/v1/students/me
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{studentToken}}
}

tests {
  test("status 200", function() { expect(res.status).to.equal(200); });
  test("current rank is now the exam target", function() { expect(String(res.body.data.currentBeltRankId)).to.equal(bru.getEnvVar("vang1Id")); });
}
