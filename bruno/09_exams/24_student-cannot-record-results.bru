meta {
  name: student cannot record results
  type: http
  seq: 24
}

post {
  url: {{baseUrl}}/api/v1/exam-registrations/{{failRegId}}/result
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{studentToken}}
  content-type: application/json
}

body:json {
  {"status": "RESULT_PASS"}
}

tests {
  test("status 403", function() { expect(res.status).to.equal(403); });
}
