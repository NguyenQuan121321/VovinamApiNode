meta {
  name: belt distribution report
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/api/v1/admin/reports/belts
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{adminToken}}
}

tests {
  test("status 200", function() { expect(res.status).to.equal(200); });
  test("distribution covers every rank", function() { expect(res.body.data.distribution.length).to.equal(JSON.parse(bru.getEnvVar("beltRanks")).length + 1); });
}
