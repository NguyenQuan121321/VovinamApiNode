meta {
  name: list users filtered by role
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/users?role=INSTRUCTOR
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{adminToken}}
}

tests {
  test("status 200", function() { expect(res.status).to.equal(200); });
  test("only instructors returned", function() { res.body.data.items.forEach(function(u){ expect(u.role).to.equal("INSTRUCTOR"); }); });
}
