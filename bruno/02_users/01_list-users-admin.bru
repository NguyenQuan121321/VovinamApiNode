meta {
  name: list users (admin)
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/users
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{adminToken}}
}

tests {
  test("status 200", function() { expect(res.status).to.equal(200); });
  test("paginated shape", function() { expect(res.body.data.items).to.be.an("array");
expect(res.body.data.limit).to.be.at.most(100); });
}
