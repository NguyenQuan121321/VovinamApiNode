meta {
  name: parent links the new student via invite code
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/parents/link
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{parentToken}}
  content-type: application/json
}

body:json {
  {"inviteCode": "{{newStudentInvite}}"}
}

tests {
  test("status 201", function() { expect(res.status).to.equal(201); });
}

docs {
  The code is single-use and rotated atomically; the same code can never link twice.
}
