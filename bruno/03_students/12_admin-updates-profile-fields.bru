meta {
  name: admin updates profile fields
  type: http
  seq: 12
}

patch {
  url: {{baseUrl}}/api/v1/students/{{newStudentId}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{adminToken}}
  content-type: application/json
}

body:json {
  {"status": "ACTIVE"}
}

tests {
  test("status 200", function() { expect(res.status).to.equal(200); });
  test("status applied", function() { expect(res.body.data.status).to.equal("ACTIVE"); });
}
