meta {
  name: remove schedule slot
  type: http
  seq: 10
}

delete {
  url: {{baseUrl}}/api/v1/classes/{{newClassId}}/schedules/{{scheduleId}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{adminToken}}
}

tests {
  test("status 200", function() { expect(res.status).to.equal(200); });
  test("removed", function() { expect(res.body.data.removed).to.equal(true); });
}
