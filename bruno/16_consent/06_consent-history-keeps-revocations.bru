meta {
  name: consent history keeps revocations
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/v1/consent/me
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{studentToken}}
}

tests {
  test("status 200", function() { expect(res.status).to.equal(200); });
  test("grant + revoke rows", function() { expect(res.body.data.items.length).to.be.at.least(2); });
}
