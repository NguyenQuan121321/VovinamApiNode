meta {
  name: re-granting is idempotent
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/consent
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{studentToken}}
  content-type: application/json
}

body:json {
  {"purpose": "MEDIA_USAGE"}
}

tests {
  test("status 201", function() { expect(res.status).to.equal(201); });
  test("alreadyActive flag", function() { expect(res.body.data.alreadyActive).to.equal(true); });
}
