meta {
  name: admin sees own account
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/api/v1/auth/me
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{adminToken}}
}

tests {
  test("status 200", function() { expect(res.status).to.equal(200); });
  test("role is ADMIN", function() { expect(res.body.data.role).to.equal("ADMIN"); });
}
