meta {
  name: reset password with garbage token is rejected
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/auth/reset-password
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {"token": "garbage-token-value-123", "password": "Whatever#2026"}
}

tests {
  test("status 400", function() { expect(res.status).to.equal(400); });
}

docs {
  Malformed action tokens answer the uniform 400 invalid-token error.
}
