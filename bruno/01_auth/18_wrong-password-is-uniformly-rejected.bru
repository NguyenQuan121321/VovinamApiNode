meta {
  name: wrong password is uniformly rejected
  type: http
  seq: 18
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {"email": "{{studentEmail}}", "password": "wrong-password-123"}
}

tests {
  test("status 401", function() { expect(res.status).to.equal(401); });
}
