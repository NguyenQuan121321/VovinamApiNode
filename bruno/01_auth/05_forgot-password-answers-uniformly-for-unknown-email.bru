meta {
  name: forgot password answers uniformly for unknown email
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/auth/forgot-password
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {"email": "nobody-uat@example.com"}
}

tests {
  test("status 200", function() { expect(res.status).to.equal(200); });
  test("sent flag (no existence disclosure)", function() { expect(res.body.data.sent).to.equal(true); });
}
