meta {
  name: student lists own sessions
  type: http
  seq: 19
}

get {
  url: {{baseUrl}}/api/v1/auth/sessions
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{studentToken}}
}

tests {
  test("status 200", function() { expect(res.status).to.equal(200); });
  test("at least one active session", function() { expect(res.body.data.length).to.be.above(0); });
}
