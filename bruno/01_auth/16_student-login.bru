meta {
  name: student login
  type: http
  seq: 16
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {"email": "{{studentEmail}}", "password": "{{demoPassword}}"}
}

script:post-response {
  const data = res.body.data;
  bru.setEnvVar("studentToken", data.tokens.accessToken);
  bru.setEnvVar("studentRefresh", data.tokens.refreshToken);
}

tests {
  test("status 200", function() { expect(res.status).to.equal(200); });
  test("role STUDENT", function() { expect(res.body.data.user.role).to.equal("STUDENT"); });
}
