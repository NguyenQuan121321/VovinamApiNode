meta {
  name: register duplicate email answers identically
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/register
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {"email": "uat-registrant@example.com", "password": "UatRegistrant#2026", "role": "STUDENT", "fullName": "UAT Registrant", "dateOfBirth": "2006-03-12"}
}

tests {
  test("status 201", function() { expect(res.status).to.equal(201); });
  test("anti-enumeration: identical response", function() { expect(res.body.data.email).to.equal("uat-registrant@example.com");
expect(res.body.data.requiresVerification).to.equal(true); });
}

docs {
  Duplicate registrations answer exactly like the first one (anti-enumeration).
}
