meta {
  name: mark own notification read
  type: http
  seq: 2
}

patch {
  url: {{baseUrl}}/api/v1/notifications/{{notificationId}}/read
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{studentToken}}
}

tests {
  test("status 200", function() { expect(res.status).to.equal(200); });
  test("readAt stamped", function() { expect(res.body.data.readAt).to.not.equal(null); });
}
