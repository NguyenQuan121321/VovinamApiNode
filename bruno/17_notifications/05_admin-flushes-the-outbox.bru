meta {
  name: admin flushes the outbox
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/admin/notifications/flush
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{adminToken}}
}

tests {
  test("status 200", function() { expect(res.status).to.equal(200); });
  test("flushed", function() { expect(res.body.data.flushed).to.equal(true); });
}
