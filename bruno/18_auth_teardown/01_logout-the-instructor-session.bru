meta {
  name: logout the instructor session
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/logout
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{instructorToken}}
}

tests {
  test("status 200", function() { expect(res.status).to.equal(200); });
  test("logged out", function() { expect(res.body.data.loggedOut).to.equal(true); });
}
