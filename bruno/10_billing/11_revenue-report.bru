meta {
  name: revenue report
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/api/v1/admin/reports/revenue?from=2026-09-01&to=2026-09-26
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{adminToken}}
}

tests {
  test("status 200", function() { expect(res.status).to.equal(200); });
  test("seeded cash revenue visible", function() { expect(res.body.data.grandTotal).to.be.at.least(400000); });
}
