meta {
  name: create percent discount code
  type: http
  seq: 17
}

post {
  url: {{baseUrl}}/api/v1/discounts
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{adminToken}}
  content-type: application/json
}

body:json {
  {"code": "UAT10", "percentOff": 10, "validFrom": "2026-01-01T00:00:00.000Z", "validUntil": "2027-12-31T23:59:59.000Z"}
}

script:post-response {
  const data = res.body.data;
  bru.setEnvVar("discountId", data.id);
}

tests {
  test("status 201", function() { expect(res.status).to.equal(201); });
}
