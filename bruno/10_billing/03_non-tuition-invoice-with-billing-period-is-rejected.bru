meta {
  name: non-tuition invoice with billing period is rejected
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/invoices
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{adminToken}}
  content-type: application/json
}

body:json {
  {"studentId": "{{studentId}}", "type": "OTHER", "items": [{"description": "x", "quantity": 1, "unitAmount": 100}], "periodMonth": 1, "periodYear": 2026}
}

tests {
  test("status 400", function() { expect(res.status).to.equal(400); });
}
