meta {
  name: delete discount code
  type: http
  seq: 25
}

delete {
  url: {{baseUrl}}/api/v1/discounts/{{discountId}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{adminToken}}
}

tests {
  test("status 200", function() { expect(res.status).to.equal(200); });
  test("deleted", function() { expect(res.body.data.deleted).to.equal(true); });
}
