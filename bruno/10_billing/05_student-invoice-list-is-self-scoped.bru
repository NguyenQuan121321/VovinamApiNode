meta {
  name: student invoice list is self-scoped
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/v1/invoices
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{studentToken}}
}

tests {
  test("status 200", function() { expect(res.status).to.equal(200); });
  test("every invoice belongs to the caller", function() { res.body.data.items.forEach(function(i){ expect(i.studentId).to.equal(bru.getEnvVar("studentId")); }); });
}
