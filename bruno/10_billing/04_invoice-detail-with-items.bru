meta {
  name: invoice detail with items
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/invoices/{{manualInvoiceId}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{adminToken}}
}

tests {
  test("status 200", function() { expect(res.status).to.equal(200); });
  test("line items present", function() { expect(res.body.data.items.length).to.equal(1);
expect(res.body.data.items[0].amount).to.equal(250000); });
}
