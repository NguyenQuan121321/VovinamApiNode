meta {
  name: unknown order reference is a 200 no-op
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/payments/webhook/simulated
  body: json
  auth: none
}

headers {
  x-signature: {{webhookSig4}}
  content-type: application/json
}

body:json {
  {{webhookBody4}}
}

script:pre-request {
  
  // ── Pure-JS crypto helpers (Bruno sandbox has no require('crypto')) ──────────
  // SHA-256 (string input, byte-safe via latin1 chars)
  function __sha256(ascii){
    function rightRotate(value, amount){return (value>>>amount)|(value<<(32-amount));}
    var mathPow=Math.pow, maxWord=mathPow(2,32), result='';
    var words=[], asciiBitLength=ascii.length*8;
    var hash=__sha256.h=__sha256.h||[], k=__sha256.k=__sha256.k||[], primeCounter=k.length;
    var isComposite={};
    for(var candidate=2;primeCounter<64;candidate++){
      if(!isComposite[candidate]){
        for(var i=0;i<313;i+=candidate)isComposite[i]=candidate;
        hash[primeCounter]=(mathPow(candidate,.5)*maxWord)|0;
        k[primeCounter++]=(mathPow(candidate,1/3)*maxWord)|0;
      }
    }
    ascii+='\x80';
    while(ascii.length%64-56)ascii+='\x00';
    for(i=0;i<ascii.length;i++){
      var j=ascii.charCodeAt(i);
      if(j>>8)return;
      words[i>>2]|=j<<((3-i)%4)*8;
    }
    words[words.length]=(asciiBitLength/maxWord)|0;
    words[words.length]=asciiBitLength;
    for(j=0;j<words.length;){
      var w=words.slice(j,j+=16);
      var oldHash=hash;
      hash=hash.slice(0,8);
      for(i=0;i<64;i++){
        var w15=w[i-15],w2=w[i-2];
        var a=hash[0],e=hash[4];
        var temp1=hash[7]
          +(rightRotate(e,6)^rightRotate(e,11)^rightRotate(e,25))
          +((e&hash[5])^((~e)&hash[6]))
          +k[i]
          +(w[i]=(i<16)?w[i]:(w[i-16]+(rightRotate(w15,7)^rightRotate(w15,18)^(w15>>>3))+w[i-7]+(rightRotate(w2,17)^rightRotate(w2,19)^(w2>>>10)))|0);
        var temp2=(rightRotate(a,2)^rightRotate(a,13)^rightRotate(a,22))+((a&hash[1])^(a&hash[2])^(hash[1]&hash[2]));
        hash=[(temp1+temp2)|0].concat(hash);
        hash[4]=(hash[4]+temp1)|0;
      }
      for(i=0;i<8;i++)hash[i]=(hash[i]+oldHash[i])|0;
    }
    for(i=0;i<8;i++){
      for(j=3;j+1;j--){
        var b=(hash[i]>>(j*8))&255;
        result+=((b<16)?0:'')+b.toString(16);
      }
    }
    return result;
  }
  // SHA-1 over a byte array
  function __sha1(bytes){
    function rol(n,s){return (n<<s)|(n>>>(32-s));}
    var H=[0x67452301,0xEFCDAB89,0x98BADCFE,0x10325476,0xC3D2E1F0];
    var ml=bytes.length*8;
    bytes=bytes.slice();
    bytes.push(0x80);
    while(bytes.length%64!==56)bytes.push(0);
    var hi=Math.floor(ml/4294967296), lo=ml>>>0;
    bytes.push((hi>>>24)&255,(hi>>>16)&255,(hi>>>8)&255,hi&255);
    bytes.push((lo>>>24)&255,(lo>>>16)&255,(lo>>>8)&255,lo&255);
    for(var b=0;b<bytes.length;b+=64){
      var w=[],i;
      for(i=0;i<16;i++)w[i]=(bytes[b+i*4]<<24)|(bytes[b+i*4+1]<<16)|(bytes[b+i*4+2]<<8)|bytes[b+i*4+3];
      for(i=16;i<80;i++)w[i]=rol(w[i-3]^w[i-8]^w[i-14]^w[i-16],1);
      var a=H[0],bb=H[1],c=H[2],d=H[3],e=H[4];
      for(i=0;i<80;i++){
        var f,k;
        if(i<20){f=(bb&c)|((~bb)&d);k=0x5A827999;}
        else if(i<40){f=bb^c^d;k=0x6ED9EBA1;}
        else if(i<60){f=(bb&c)|(bb&d)|(c&d);k=0x8F1BBCDC;}
        else{f=bb^c^d;k=0xCA62C1D6;}
        var t=(rol(a,5)+f+e+k+w[i])&0xffffffff;
        e=d;d=c;c=rol(bb,30);bb=a;a=t;
      }
      H[0]=(H[0]+a)&0xffffffff;H[1]=(H[1]+bb)&0xffffffff;H[2]=(H[2]+c)&0xffffffff;H[3]=(H[3]+d)&0xffffffff;H[4]=(H[4]+e)&0xffffffff;
    }
    return H.map(function(x){return (x>>>0).toString(16).padStart(8,'0');}).join('');
  }
  function __strBytes(str){
    var out=[];
    for(var i=0;i<str.length;i++){
      var c=str.charCodeAt(i);
      if(c<128)out.push(c);
      else{
        // UTF-8 encode non-ASCII
        if(c<2048){out.push(192|(c>>6),128|(c&63));}
        else{out.push(224|(c>>12),128|((c>>6)&63),128|(c&63));}
      }
    }
    return out;
  }
  function __hexBytes(hex){
    return hex.match(/../g).map(function(h){return parseInt(h,16);});
  }
  function __hmac(algo,keyBytes,msgBytes){
    var block=64;
    var k=keyBytes.slice();
    if(k.length>block){
      var hex=algo==='sha1'?__sha1(k):__sha256(k.map(function(c){return String.fromCharCode(c);}).join(''));
      k=__hexBytes(hex);
    }
    while(k.length<block)k.push(0);
    var o=[],ip=[],i;
    for(i=0;i<block;i++){o.push(k[i]^0x5c);ip.push(k[i]^0x36);}
    var innerHex=algo==='sha1'?__sha1(ip.concat(msgBytes)):__sha256(ip.concat(msgBytes).map(function(c){return String.fromCharCode(c);}).join(''));
    var outer=o.concat(__hexBytes(innerHex));
    return algo==='sha1'?__sha1(outer):__sha256(outer.map(function(c){return String.fromCharCode(c);}).join(''));
  }
  function __base32Decode(input){
    var alphabet='ABCDEFGHIJKLMNOPQRSTUVWXYZ234567';
    var bits=0,value=0,output=[];
    for(var i=0;i<input.length;i++){
      var ch=input.charAt(i).toUpperCase();
      if(ch==='='||ch===' ')continue;
      var idx=alphabet.indexOf(ch);
      if(idx<0)continue;
      value=(value<<5)|idx;bits+=5;
      if(bits>=8){output.push((value>>>(bits-8))&255);bits-=8;}
    }
    return output;
  }
  function __totp(secretB32, atMs){
    var counter=Math.floor(atMs/1000/30);
    var msg=[]; var c=counter;
    for(var i=7;i>=0;i--){msg[i]=c&255;c=Math.floor(c/256);}
    var mac=__hmac('sha1',__base32Decode(secretB32),msg);
    var offset=parseInt(mac.charAt(mac.length-1),16);
    var bin=0;
    bin|=(parseInt(mac.substr(offset*2,2),16)&0x7f)<<24;
    bin|=parseInt(mac.substr(offset*2+2,2),16)<<16;
    bin|=parseInt(mac.substr(offset*2+4,2),16)<<8;
    bin|=parseInt(mac.substr(offset*2+6,2),16);
    var code=(bin%1000000).toString();
    while(code.length<6)code='0'+code;
    return code;
  }
  
  var body = '{"orderRef":"VVUNKNOWN99","gatewayTxnId":"UAT-TXN-X","amount":1000,"success":true}';
  bru.setEnvVar("webhookBody4", body);
  bru.setEnvVar("webhookSig4", __hmac("sha256", __strBytes(bru.getEnvVar("webhookSecret")), __strBytes(body)));
}

tests {
  test("status 200", function() { expect(res.status).to.equal(200); });
  test("processed false", function() { expect(res.body.data.processed).to.equal(false); });
}
