meta {
  name: invoice re-derives to UNPAID after refund
  type: http
  seq: 17
}

get {
  url: {{baseUrl}}/api/v1/invoices/{{manualInvoiceId}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{adminToken}}
}

tests {
  test("status 200", function() { expect(res.status).to.equal(200); });
  test("back to UNPAID", function() { expect(res.body.data.status).to.equal("UNPAID"); });
}
