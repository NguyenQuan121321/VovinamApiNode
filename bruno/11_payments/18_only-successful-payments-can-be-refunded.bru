meta {
  name: only successful payments can be refunded
  type: http
  seq: 18
}

patch {
  url: {{baseUrl}}/api/v1/payments/{{cashPaymentId}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{adminToken}}
  content-type: application/json
}

body:json {
  {"status": "REFUNDED"}
}

tests {
  test("status 409", function() { expect(res.status).to.equal(409); });
}
