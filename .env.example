# ─── Runtime ────────────────────────────────────────────────────────────────
# local | test | staging | production ("release mode" = production)
NODE_ENV=local
PORT=3000

# ─── Database (required, fail-fast on boot) ─────────────────────────────────
DATABASE_URL=postgresql://vovinam:vovinam@localhost:5432/vovinam?schema=public

# ─── JWT (required) ─────────────────────────────────────────────────────────
# Production must use a fresh 64-hex random secret. Min length 32.
JWT_SECRET=local-dev-only-secret-change-me-0123456789abcdef
# Previous signing key kept only while rotating; remove after rotation completes.
JWT_SECRET_PREVIOUS=
JWT_ISSUER=vovinam-api
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# ─── Encryption ─────────────────────────────────────────────────────────────
# 32-byte key as 64 hex chars; seals TOTP secrets with AES-256-GCM.
# Optional locally, REQUIRED in production (boot fails without it).
APP_ENCRYPTION_KEY=

# ─── Auth / lockout / rate limits ───────────────────────────────────────────
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION=15m
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100
# Strict per-IP window for the /auth surface only (register, login, refresh,
# verification mail, reset, MFA). Raise if many legitimate users share one IP.
AUTH_IP_LIMIT_MAX=30
AUTH_IP_LIMIT_TTL_SECONDS=60

# ─── CORS / Swagger / metrics ───────────────────────────────────────────────
# Comma-separated origin allowlist, e.g. https://app.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Swagger UI is disabled by default and must stay off in production unless CSP is reviewed.
SWAGGER_ENABLED=false
# Bearer token protecting GET /metrics; required in production (boot fails without it).
METRICS_TOKEN=

# ─── Mail delivery (plan 7.6) ───────────────────────────────────────────────
# logging (default) keeps outbound mail in the pino log (local/e2e; MAIL_LOG_FILE
# can capture messages for tests). smtp delivers through nodemailer and REQUIRES
# SMTP_HOST and SMTP_FROM; SMTP_USER/SMTP_PASSWORD enable SMTP auth when both set.
# MAIL_LOG_FILE writes full messages (incl. single-use tokens) to disk and is
# FORBIDDEN in production (boot fails if set).
MAIL_DRIVER=logging
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# MAIL_LOG_FILE=/tmp/vovinam-mail.log

# ─── Payment gateway payOS (primary QR channel; plan 7.5) ───────────────────
# Required when PAYMENTS_GATEWAY=payos. RETURN/CANCEL URLs are frontend pages
# the payOS checkout redirects to. Register the webhook URL
# (https://<host>/api/v1/payments/webhook/payos) in the payOS dashboard —
# webhooks are verified with the payOS checksum key, not PAYMENTS_WEBHOOK_SECRET.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=
PAYOS_CANCEL_URL=

# ─── QR payment wiring (plan 7.5) ───────────────────────────────────────────
# payos | sepay | simulated. 'simulated' is the local/test adapter: it signs
# webhooks with PAYMENTS_WEBHOOK_SECRET (REQUIRED whenever simulated is
# selected — without it webhooks can never verify) and never contacts a real
# provider. PRODUCTION forbids 'simulated' (boot fails); only 'payos'/'sepay'
# are legal there. 'payos' activates the real adapter (credentials above
# required, fail-fast otherwise). No SePay adapter exists; selecting it blocks boot.
PAYMENTS_GATEWAY=simulated
PAYMENTS_WEBHOOK_SECRET=local-dev-only-webhook-secret-0123456789

# ─── Zalo ZNS (optional; absent = ZNS notifications disabled) ───────────────
ZALO_OA_ACCESS_TOKEN=
ZALO_OA_APP_ID=
ZALO_OA_SECRET_KEY=

# ─── SMS fallback via eSMS (optional; absent = SMS disabled) ────────────────
ESMS_API_KEY=
ESMS_SECRET_KEY=
ESMS_BRANDNAME=

# ─── Seed (used only by `npm run seed`, never read by the app) ──────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123
