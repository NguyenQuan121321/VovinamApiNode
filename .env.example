# ─── Runtime ────────────────────────────────────────────────────────────────
# local | test | staging | production ("release mode" = production)
NODE_ENV=local
PORT=3000

# ─── Database (required, fail-fast on boot) ─────────────────────────────────
DATABASE_URL=postgresql://vovinam:vovinam@localhost:5432/vovinam?schema=public

# ─── JWT (required) ─────────────────────────────────────────────────────────
# Production must use a fresh 64-hex random secret. Min length 32.
JWT_SECRET=local-dev-only-secret-change-me-0123456789abcdef
# Previous signing key kept only while rotating; remove after rotation completes.
JWT_SECRET_PREVIOUS=
JWT_ISSUER=vovinam-api
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# ─── Encryption ─────────────────────────────────────────────────────────────
# 32-byte key as 64 hex chars; seals TOTP secrets with AES-256-GCM.
# Optional locally, REQUIRED in production (boot fails without it).
APP_ENCRYPTION_KEY=

# ─── Auth / lockout / rate limits ───────────────────────────────────────────
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION=15m
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100

# ─── CORS / Swagger / metrics ───────────────────────────────────────────────
# Comma-separated origin allowlist, e.g. https://app.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Swagger UI is disabled by default and must stay off in production unless CSP is reviewed.
SWAGGER_ENABLED=false
# Bearer token protecting GET /metrics; required in production (boot fails without it).
METRICS_TOKEN=

# ─── SMTP (optional; absent = email sending disabled) ───────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ─── Payment gateway payOS (optional; absent = QR payments disabled) ────────
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# ─── Zalo ZNS (optional; absent = ZNS notifications disabled) ───────────────
ZALO_OA_ACCESS_TOKEN=
ZALO_OA_APP_ID=
ZALO_OA_SECRET_KEY=

# ─── SMS fallback via eSMS (optional; absent = SMS disabled) ────────────────
ESMS_API_KEY=
ESMS_SECRET_KEY=
ESMS_BRANDNAME=

# ─── Seed (used only by `npm run seed`, never read by the app) ──────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123
