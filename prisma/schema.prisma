// VovinamApiNode — authoritative schema (docs/DATABASE_BASELINE.md, TASK-02):
// auth tables (plan section 5.2), app settings, belt ranks, the domain core
// (students/parents/classes/enrollments/attendance), belts/exams with the invoice
// chain, payments, notifications/consent, and club announcements (AD-07).
// Financial tables use ON DELETE RESTRICT and are never hard-deleted; users and
// student profiles are soft-delete only (plan 7.2) — no hard delete anywhere.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  INSTRUCTOR
  STUDENT
  PARENT
}

enum UsedTokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
  CHANGE_EMAIL
}

enum BeltRankGroup {
  LAM
  VANG
  DO
  HUYEN
}

enum StudentStatus {
  PENDING
  ACTIVE
  PAUSED
  LEFT
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum LinkRelationship {
  PARENT
  GUARDIAN
}

enum ClassStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  EXCUSED
}

enum ExamStatus {
  DRAFT
  OPEN
  CLOSED
  COMPLETED
  CANCELLED
}

enum ExamRegistrationStatus {
  PENDING_PAYMENT
  PAID
  RESULT_PASS
  RESULT_FAIL
  CANCELLED
}

enum InvoiceType {
  TUITION
  EXAM_FEE
  UNIFORM
  OTHER
}

enum InvoiceStatus {
  UNPAID
  PAID
  OVERDUE
  CANCELLED
  REFUNDED
}

enum PaymentGateway {
  PAYOS
  SEPAY
  CASH
  BANK_TRANSFER
}

enum PaymentTxnStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
  DISPUTED
}

enum NotificationChannel {
  EMAIL
  ZNS
  SMS
  INAPP
}

enum NotificationStatus {
  QUEUED
  SENDING
  SENT
  FAILED
  SKIPPED
}

enum ConsentPurpose {
  DATA_PROCESSING
  MEDIA_USAGE
  MARKETING_NOTICE
}

enum AnnouncementAudience {
  ALL
  CLASS
}

/// Accounts for all four roles. Soft delete only (plan 7.2): deletedAt / isActive,
/// never a hard DELETE, so every FK below uses onDelete: Restrict.
model User {
  id                  String    @id @default(uuid()) @db.Uuid
  email               String    @unique
  passwordHash        String    @map("password_hash")
  role                UserRole  @default(STUDENT)
  emailVerifiedAt     DateTime? @map("email_verified_at")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  pwdVersion          Int       @default(1) @map("pwd_version")
  isActive            Boolean   @default(true) @map("is_active")
  deletedAt           DateTime? @map("deleted_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  sessions              Session[]
  refreshTokens         RefreshToken[]
  totpCredential        TotpCredential?
  recoveryCodes         RecoveryCode[]
  usedTokens            UsedToken[]
  auditLogs             AuditLog[]
  appSettingUpdates     AppSetting[]         @relation("AppSettingUpdatedBy")
  studentProfile        StudentProfile?
  parentLinks           ParentStudentLink[]  @relation("ParentLink")
  verifiedLinks         ParentStudentLink[]  @relation("LinkVerifier")
  taughtClasses         Class[]              @relation("ClassInstructor")
  attendedSessions      AttendanceSession[]  @relation("SessionInstructor")
  recordedAttendance    AttendanceRecord[]   @relation("AttendanceRecorder")
  examinedResults       ExamRegistration[]   @relation("ExamExaminer")
  createdInvoices       Invoice[]            @relation("InvoiceCreator")
  cashPayments          PaymentTransaction[] @relation("CashRecorder")
  authoredAnnouncements Announcement[]       @relation("AnnouncementAuthor")
  notifications         Notification[]
  consents              ConsentLog[]
  consentActions        ConsentLog[]         @relation("ConsentActor")
  leaveRequestsMade     LeaveRequest[]       @relation("LeaveRequestRequester")
  leaveRequestsReviewed LeaveRequest[]       @relation("LeaveRequestReviewer")
  proposalsAuthored     PromotionProposal[]  @relation("ProposalAuthor")
  proposalsReviewed     PromotionProposal[]  @relation("ProposalReviewer")
  evaluationsAuthored   StudentEvaluation[]  @relation("EvaluationAuthor")

  @@map("users")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  ip           String?
  userAgent    String?  @map("user_agent")
  deviceName   String?  @map("device_name")
  revoked      Boolean  @default(false)
  lastActiveAt DateTime @default(now()) @map("last_active_at")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@map("sessions")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  sessionId String   @map("session_id") @db.Uuid
  /// SHA-256 hash of the opaque 256-bit token; raw token is never stored (plan 4.1).
  tokenHash String   @unique @map("token_hash")
  revoked   Boolean  @default(false)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("refresh_tokens")
}

/// TOTP secrets sealed with AES-256-GCM using APP_ENCRYPTION_KEY (plan 4.1).
model TotpCredential {
  userId          String   @id @map("user_id") @db.Uuid
  secretEncrypted Bytes    @map("secret_encrypted")
  enabledAt       DateTime @map("enabled_at")
  createdAt       DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("totp_credentials")
}

model RecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("recovery_codes")
}

/// Single-use guard for verify-email / reset-password / change-email tokens (plan 5.1).
/// expiresAt drives the purge job.
model UsedToken {
  jti       String           @id
  userId    String           @map("user_id") @db.Uuid
  purpose   UsedTokenPurpose
  expiresAt DateTime         @map("expires_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([expiresAt])
  @@map("used_tokens")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    String?  @map("user_id") @db.Uuid
  event     String   @db.VarChar(50)
  ip        String?
  success   Boolean
  detail    String?  @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@map("audit_logs")
}

/// Key-value club configuration: bank_account (owner_type BUSINESS), tuition_rates,
/// gateway references (plan sections 6, 7.5, 10). Seeded values are defaults; the club
/// master confirms real data before go-live (plan risk register).
model AppSetting {
  key       String   @id @db.VarChar(50)
  value     Json
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  updatedByUser User? @relation("AppSettingUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)

  @@map("app_settings")
}

model BeltRank {
  id         Int           @id @default(autoincrement())
  code       String        @unique
  name       String        @db.VarChar(100)
  rankGroup  BeltRankGroup @map("rank_group")
  orderIndex Int           @unique @map("order_index")
  isActive   Boolean       @default(true) @map("is_active")

  students                 StudentProfile[]
  exams                    BeltExam[]         @relation("ExamTargetRank")
  currentRankRegistrations ExamRegistration[] @relation("RegistrationCurrentRank")
  targetRankRegistrations  ExamRegistration[] @relation("RegistrationTargetRank")
  proposals                PromotionProposal[] @relation("ProposalTargetRank")

  @@map("belt_ranks")
}

/// One profile per student. Minors (plan 7.1) get a profile WITHOUT a user account;
/// an adult student self-registers and the admin links/approves the profile
/// (userId set, status PENDING -> ACTIVE). Soft delete only (plan 7.2).
model StudentProfile {
  id                    String        @id @default(uuid()) @db.Uuid
  userId                String?       @unique @map("user_id") @db.Uuid
  user                  User?         @relation(fields: [userId], references: [id])
  fullName              String        @map("full_name") @db.VarChar(100)
  dob                   DateTime      @db.Date
  gender                Gender
  phone                 String?       @db.VarChar(20)
  address               String?       @db.VarChar(255)
  emergencyContactName  String?       @map("emergency_contact_name") @db.VarChar(100)
  emergencyContactPhone String?       @map("emergency_contact_phone") @db.VarChar(20)
  medicalNotes          String?       @map("medical_notes") @db.VarChar(1000)
  currentBeltRankId     Int?          @map("current_belt_rank_id")
  currentBeltRank       BeltRank?     @relation(fields: [currentBeltRankId], references: [id])
  inviteCode            String        @unique @map("invite_code") @db.Char(8)
  joinedAt              DateTime      @default(now()) @map("joined_at")
  status                StudentStatus @default(PENDING)
  deletedAt             DateTime?     @map("deleted_at")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  parentLinks       ParentStudentLink[]
  enrollments       Enrollment[]
  attendanceRecords AttendanceRecord[]
  examRegistrations ExamRegistration[]
  invoices          Invoice[]
  leaveRequests     LeaveRequest[]      @relation("LeaveRequestStudent")
  proposals         PromotionProposal[] @relation("PromotionProposalStudent")
  evaluations       StudentEvaluation[] @relation("EvaluationStudent")

  @@map("student_profiles")
}

/// Parent-child link through a single-use invite code (plan 7.1). Direct entry of
/// student ids is never accepted.
model ParentStudentLink {
  id               String           @id @default(uuid()) @db.Uuid
  parentUserId     String           @map("parent_user_id") @db.Uuid
  parent           User             @relation("ParentLink", fields: [parentUserId], references: [id], onDelete: Cascade)
  studentId        String           @map("student_id") @db.Uuid
  student          StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  relationship     LinkRelationship @default(PARENT)
  verified         Boolean          @default(false)
  verifiedByUserId String?          @map("verified_by_user_id") @db.Uuid
  verifiedByUser   User?            @relation("LinkVerifier", fields: [verifiedByUserId], references: [id])
  createdAt        DateTime         @default(now()) @map("created_at")

  @@unique([parentUserId, studentId])
  @@index([parentUserId])
  @@index([studentId])
  @@map("parent_student_links")
}

/// A training class taught by one instructor (plan section 6). "Deleting" a class
/// means ARCHIVED via PATCH — enrollment/attendance history must survive.
model Class {
  id           String      @id @default(uuid()) @db.Uuid
  name         String      @db.VarChar(100)
  instructorId String      @map("instructor_id") @db.Uuid
  instructor   User        @relation("ClassInstructor", fields: [instructorId], references: [id], onDelete: Restrict)
  location     String?     @db.VarChar(255)
  capacity     Int         @default(30)
  status       ClassStatus @default(ACTIVE)
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  schedules          ClassSchedule[]
  enrollments        Enrollment[]
  attendanceSessions AttendanceSession[]
  announcements      Announcement[]
  leaveRequests      LeaveRequest[]      @relation("LeaveRequestClass")
  evaluations        StudentEvaluation[] @relation("EvaluationClass")

  @@index([instructorId])
  @@map("classes")
}

/// Recurring weekly time slot. TIME columns carry time-of-day only; Prisma maps
/// them to Date values on the 1970-01-01 epoch, so the API layer converts to/from
/// "HH:mm" strings and never exposes raw Dates (plan section 6).
model ClassSchedule {
  id            String    @id @default(uuid()) @db.Uuid
  classId       String    @map("class_id") @db.Uuid
  class         Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  /// 0 = Sunday .. 6 = Saturday (Postgres DOW convention).
  weekday       Int       @db.SmallInt
  startTime     DateTime  @map("start_time") @db.Time(0)
  endTime       DateTime  @map("end_time") @db.Time(0)
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date

  @@index([classId])
  @@map("class_schedules")
}

/// One enrollment period per row (a student may leave and rejoin later, which the
/// exact-timestamp unique tolerates). The service additionally rejects a second
/// open or same-day enrollment per (student, class) — the plan's
/// UQ(student_id, class_id, enrolled_at::date) semantics (plan section 6).
model Enrollment {
  id         String         @id @default(uuid()) @db.Uuid
  studentId  String         @map("student_id") @db.Uuid
  student    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Restrict)
  classId    String         @map("class_id") @db.Uuid
  class      Class          @relation(fields: [classId], references: [id], onDelete: Restrict)
  enrolledAt DateTime       @default(now()) @map("enrolled_at")
  /// NULL while the student is in the class; removal sets this (soft leave).
  leftAt     DateTime?      @map("left_at")

  @@unique([studentId, classId, enrolledAt])
  @@index([classId])
  @@index([studentId])
  @@map("enrollments")
}

/// One held lesson: a class on a specific date (plan section 6).
model AttendanceSession {
  id           String   @id @default(uuid()) @db.Uuid
  classId      String   @map("class_id") @db.Uuid
  class        Class    @relation(fields: [classId], references: [id], onDelete: Restrict)
  sessionDate  DateTime @map("session_date") @db.Date
  /// Who taught the session: the instructor taking attendance, or the class
  /// instructor when an admin creates the session.
  instructorId String   @map("instructor_id") @db.Uuid
  instructor   User     @relation("SessionInstructor", fields: [instructorId], references: [id], onDelete: Restrict)
  topic        String?  @db.VarChar(200)
  createdAt    DateTime @default(now()) @map("created_at")

  records AttendanceRecord[]

  @@unique([classId, sessionDate])
  @@index([instructorId])
  @@map("attendance_sessions")
}

/// Per-student attendance for one session; re-submitting overwrites via upsert
/// (plan section 8: bulk upsert).
model AttendanceRecord {
  id                  String            @id @default(uuid()) @db.Uuid
  attendanceSessionId String            @map("attendance_session_id") @db.Uuid
  session             AttendanceSession @relation(fields: [attendanceSessionId], references: [id], onDelete: Cascade)
  studentId           String            @map("student_id") @db.Uuid
  student             StudentProfile    @relation(fields: [studentId], references: [id], onDelete: Restrict)
  status              AttendanceStatus
  note                String?           @db.VarChar(200)
  recordedBy          String            @map("recorded_by") @db.Uuid
  recordedByUser      User              @relation("AttendanceRecorder", fields: [recordedBy], references: [id], onDelete: Restrict)
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  @@unique([attendanceSessionId, studentId])
  @@map("attendance_records")
}

/// A belt grading event (plan section 6). Registration is only possible while
/// status is OPEN and before registrationDeadline.
model BeltExam {
  id                   String     @id @default(uuid()) @db.Uuid
  code                 String     @unique @db.VarChar(30)
  title                String     @db.VarChar(150)
  examDate             DateTime   @map("exam_date") @db.Date
  location             String?    @db.VarChar(255)
  targetRankId         Int        @map("target_rank_id")
  targetRank           BeltRank   @relation("ExamTargetRank", fields: [targetRankId], references: [id])
  /// VND integer, no decimals.
  feeAmount            Int        @map("fee_amount")
  /// NULL = no cap.
  capacity             Int?
  registrationDeadline DateTime   @map("registration_deadline") @db.Date
  status               ExamStatus @default(DRAFT)
  createdAt            DateTime   @default(now()) @map("created_at")
  updatedAt            DateTime   @updatedAt @map("updated_at")

  registrations ExamRegistration[]

  @@index([examDate])
  @@map("belt_exams")
}

/// One student registered for one exam (plan section 6). On RESULT_PASS the
/// student's current_belt_rank_id is promoted to the exam's target rank.
model ExamRegistration {
  id            String                 @id @default(uuid()) @db.Uuid
  examId        String                 @map("exam_id") @db.Uuid
  exam          BeltExam               @relation(fields: [examId], references: [id], onDelete: Restrict)
  studentId     String                 @map("student_id") @db.Uuid
  student       StudentProfile         @relation(fields: [studentId], references: [id], onDelete: Restrict)
  /// Rank held at registration time (NULL = beginner with no rank yet).
  currentRankId Int?                   @map("current_rank_id")
  currentRank   BeltRank?              @relation("RegistrationCurrentRank", fields: [currentRankId], references: [id])
  targetRankId  Int                    @map("target_rank_id")
  targetRank    BeltRank               @relation("RegistrationTargetRank", fields: [targetRankId], references: [id])
  status        ExamRegistrationStatus @default(PENDING_PAYMENT)
  resultNote    String?                @map("result_note") @db.VarChar(500)
  /// Who judged the exam; defaults to the caller recording the result.
  examinerId    String?                @map("examiner_id") @db.Uuid
  examiner      User?                  @relation("ExamExaminer", fields: [examinerId], references: [id])
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")

  invoices Invoice[]

  @@unique([examId, studentId])
  @@index([studentId])
  @@map("exam_registrations")
}

/// Financial record (plan sections 6, 7.5): never hard-deleted; payments arrive
/// in P4. invoice_no is human-readable and sequential per year (INV-2026-0001).
model Invoice {
  id                    String            @id @default(uuid()) @db.Uuid
  invoiceNo             String            @unique @map("invoice_no") @db.VarChar(20)
  studentId             String            @map("student_id") @db.Uuid
  student               StudentProfile    @relation(fields: [studentId], references: [id], onDelete: Restrict)
  type                  InvoiceType
  /// Set when the invoice was auto-issued for an exam registration (P3).
  refExamRegistrationId String?           @map("ref_exam_registration_id") @db.Uuid
  refExamRegistration   ExamRegistration? @relation(fields: [refExamRegistrationId], references: [id])
  /// TUITION period only (month 1-12).
  periodMonth           Int?              @map("period_month")
  periodYear            Int?              @map("period_year")
  /// VND integers; total = subtotal - discount.
  subtotal              Int
  discount              Int               @default(0)
  total                 Int
  status                InvoiceStatus     @default(UNPAID)
  dueDate               DateTime          @map("due_date") @db.Date
  issuedAt              DateTime          @default(now()) @map("issued_at")
  note                  String?           @db.VarChar(500)
  createdBy             String            @map("created_by") @db.Uuid
  createdByUser         User              @relation("InvoiceCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  items    InvoiceItem[]
  payments PaymentTransaction[]

  /// Monthly-tuition idempotency (plan 7.7): one TUITION invoice per student per
  /// period. Period columns are NULL for EXAM_FEE/UNIFORM/OTHER invoices, and
  /// Postgres unique constraints treat NULLs as distinct, so those stay unlimited.
  @@unique([studentId, type, periodMonth, periodYear])
  @@index([studentId])
  @@index([status])
  @@map("invoices")
}

/// Line items of an invoice (plan section 6); cascade only with their invoice.
model InvoiceItem {
  id          String  @id @default(uuid()) @db.Uuid
  invoiceId   String  @map("invoice_id") @db.Uuid
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String  @db.VarChar(255)
  quantity    Int
  unitAmount  Int     @map("unit_amount")
  /// quantity * unitAmount.
  amount      Int

  @@index([invoiceId])
  @@map("invoice_items")
}

/// One payment attempt against an invoice (plan sections 6, 7.5). Success is
/// only ever recorded from a verified gateway webhook or an explicit admin CASH
/// confirmation; the invoice is PAID when the sum of SUCCESS transactions
/// reaches its total. gateway_txn_id is the DB-layer idempotency guard (S-03).
model PaymentTransaction {
  id             String           @id @default(uuid()) @db.Uuid
  invoiceId      String           @map("invoice_id") @db.Uuid
  invoice        Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  /// "VV" + 8 unambiguous characters, embedded in the transfer content.
  orderRef       String           @unique @map("order_ref") @db.VarChar(20)
  gateway        PaymentGateway
  gatewayTxnId   String?          @unique @map("gateway_txn_id") @db.VarChar(64)
  amount         Int
  status         PaymentTxnStatus @default(PENDING)
  paidAt         DateTime?        @map("paid_at")
  /// QR pending expires 30 minutes after creation (plan 7.5).
  expiresAt      DateTime?        @map("expires_at")
  /// Admin who confirmed a CASH payment.
  recordedBy     String?          @map("recorded_by") @db.Uuid
  recordedByUser User?            @relation("CashRecorder", fields: [recordedBy], references: [id])
  note           String?          @db.VarChar(500)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  @@index([invoiceId])
  @@index([status])
  @@map("payment_transactions")
}

/// One outbound message on the notification outbox (plan 7.6). Business state
/// changes and their outbox rows commit in ONE transaction; the in-process
/// worker then delivers with retry/backoff. INAPP rows are delivered to the
/// feed at insert (status SENT, readAt set when read). user_id is SET NULL so
/// delivery history survives account deletion without blocking it.
model Notification {
  id            String              @id @default(uuid()) @db.Uuid
  userId        String?             @map("user_id") @db.Uuid
  user          User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  channel       NotificationChannel
  templateCode  String              @map("template_code") @db.VarChar(50)
  /// Minimal per-template data (plan 7.6: minimum data, no sensitive payloads).
  payload       Json
  status        NotificationStatus  @default(QUEUED)
  /// Delivery attempts across the fallback chain; capped by the worker.
  retries       Int                 @default(0)
  /// NULL = immediately eligible; the backoff sets this on transient failure.
  nextAttemptAt DateTime?           @map("next_attempt_at")
  error         String?             @db.VarChar(500)
  readAt        DateTime?           @map("read_at")
  sentAt        DateTime?           @map("sent_at")
  createdAt     DateTime            @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([status, nextAttemptAt])
  @@map("notifications")
}

/// Purpose-specific consent record (plan section 6, Decree 13). Append-only:
/// each grant is a new row; revocation stamps revokedAt on the active row, and
/// a later re-grant adds another row — history is never erased. The subject is
/// the account holder (user_id); a verified parent consenting for a linked
/// minor is recorded in consented_by_user_id (plan 7.1).
model ConsentLog {
  id                String         @id @default(uuid()) @db.Uuid
  userId            String         @map("user_id") @db.Uuid
  user              User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  purpose           ConsentPurpose
  /// NULL when the subject consented for themselves; the acting PARENT for minors.
  consentedByUserId String?        @map("consented_by_user_id") @db.Uuid
  consentedByUser   User?          @relation("ConsentActor", fields: [consentedByUserId], references: [id], onDelete: Restrict)
  consentedAt       DateTime       @default(now()) @map("consented_at")
  revokedAt         DateTime?      @map("revoked_at")

  @@index([userId, purpose])
  @@map("consent_logs")
}

/// Club-activity announcement (plan section 6, AD-07): curated content authored
/// by ADMIN for the whole club (ALL) or one class (CLASS). The announcement row
/// IS the content; the notifications module stays a delivery channel and never
/// absorbs this domain. audience=CLASS requires classId and audience=ALL forbids
/// it — enforced in the service (not expressible as a Prisma constraint).
model Announcement {
  id            String               @id @default(uuid()) @db.Uuid
  title         String               @db.VarChar(150)
  body          String               @db.Text
  audience      AnnouncementAudience
  /// Target class for CLASS audience; NULL for ALL.
  classId       String?              @map("class_id") @db.Uuid
  class         Class?               @relation(fields: [classId], references: [id], onDelete: Cascade)
  /// Feed ordering stamp; set at creation (no draft state in the plan).
  publishedAt   DateTime             @default(now()) @map("published_at")
  createdBy     String               @map("created_by") @db.Uuid
  createdByUser User                 @relation("AnnouncementAuthor", fields: [createdBy], references: [id], onDelete: Restrict)
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  @@index([classId])
  @@index([publishedAt])
  @@map("announcements")
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ProposalStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Student absence request for one class session (matrix row 11): the student or
/// a linked parent creates it, the instructor (own class) or admin reviews it.
/// Unique per (student, class, date) so one session cannot collect duplicates.
model LeaveRequest {
  id                String             @id @default(uuid()) @db.Uuid
  studentId         String             @map("student_id") @db.Uuid
  student           StudentProfile     @relation("LeaveRequestStudent", fields: [studentId], references: [id], onDelete: Restrict)
  classId           String             @map("class_id") @db.Uuid
  class             Class              @relation("LeaveRequestClass", fields: [classId], references: [id], onDelete: Restrict)
  /// Account that submitted the request: the student, the linked parent, or the
  /// admin creating on a student's behalf (NULL only for admin creation).
  requestedByUserId String?            @map("requested_by_user_id") @db.Uuid
  requestedBy       User?              @relation("LeaveRequestRequester", fields: [requestedByUserId], references: [id])
  sessionDate       DateTime           @map("session_date") @db.Date
  reason            String             @db.VarChar(500)
  status            LeaveRequestStatus @default(PENDING)
  reviewedByUserId  String?            @map("reviewed_by_user_id") @db.Uuid
  reviewedBy        User?              @relation("LeaveRequestReviewer", fields: [reviewedByUserId], references: [id])
  reviewedAt        DateTime?
  reviewNote        String?            @db.VarChar(500)
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  @@unique([studentId, classId, sessionDate])
  @@index([classId, sessionDate])
  @@index([status])
  @@map("leave_requests")
}

/// Instructor/master proposal to promote a student (matrix row 14). Recording the
/// approval is advisory bookkeeping — the belt itself still changes only through
/// an exam RESULT_PASS (plan 13.4).
model PromotionProposal {
  id               String         @id @default(uuid()) @db.Uuid
  studentId        String         @map("student_id") @db.Uuid
  student          StudentProfile @relation("PromotionProposalStudent", fields: [studentId], references: [id], onDelete: Restrict)
  proposedRankId   Int            @map("proposed_rank_id")
  proposedRank     BeltRank       @relation("ProposalTargetRank", fields: [proposedRankId], references: [id], onDelete: Restrict)
  proposedByUserId String         @map("proposed_by_user_id") @db.Uuid
  proposedBy       User           @relation("ProposalAuthor", fields: [proposedByUserId], references: [id], onDelete: Restrict)
  note             String?        @db.VarChar(500)
  status           ProposalStatus @default(PENDING)
  reviewedByUserId String?        @map("reviewed_by_user_id") @db.Uuid
  reviewedBy       User?          @relation("ProposalReviewer", fields: [reviewedByUserId], references: [id])
  reviewedAt       DateTime?
  reviewNote       String?        @db.VarChar(500)
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  @@index([studentId])
  @@index([status])
  @@map("promotion_proposals")
}

/// Periodic instructor evaluation of a student (matrix row 12). One evaluation
/// per (student, author, period) while the period is given; NULL-period ad-hoc
/// evaluations are unlimited (Postgres unique never collides on NULLs).
model StudentEvaluation {
  id           String         @id @default(uuid()) @db.Uuid
  studentId    String         @map("student_id") @db.Uuid
  student      StudentProfile @relation("EvaluationStudent", fields: [studentId], references: [id], onDelete: Restrict)
  authorUserId String         @map("author_user_id") @db.Uuid
  author       User           @relation("EvaluationAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  classId      String?        @map("class_id") @db.Uuid
  class        Class?         @relation("EvaluationClass", fields: [classId], references: [id], onDelete: SetNull)
  periodMonth  Int?           @map("period_month")
  periodYear   Int?           @map("period_year")
  /// 1..10; the meaning of the scale is the club's.
  rating       Int
  comment      String?        @db.VarChar(1000)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  @@unique([studentId, authorUserId, periodMonth, periodYear])
  @@index([studentId])
  @@map("student_evaluations")
}

/// Discount code ("khuyến mãi", matrix row 23) applied at invoice creation.
/// Exactly one of percentOff / amountOff is required (application-validated);
/// the invoice stores the resulting discount amount, the code stays config data.
model DiscountCode {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(40)
  description String?  @db.VarChar(200)
  /// Percentage of the invoice subtotal (1..100).
  percentOff  Int?     @map("percent_off")
  /// Fixed VND amount subtracted from the subtotal.
  amountOff   Int?     @map("amount_off")
  validFrom   DateTime @map("valid_from") @db.Date
  validUntil  DateTime @map("valid_until") @db.Date
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("discount_codes")
}
